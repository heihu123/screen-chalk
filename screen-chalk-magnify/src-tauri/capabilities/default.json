{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力：允许核心窗口与事件操作（main 标注层 + note 便签）",
  "windows": ["main", "note"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:tray:default",
    "opener:default"
  ]
}
